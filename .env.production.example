# ============================================================================
# Pet Helper — production environment TEMPLATE
#
# Sao chép thành `.env.production` TRÊN MÁY ĐÍCH rồi điền giá trị thật.
#   - KHÔNG commit `.env.production`.
#   - KHÔNG copy file này vào image.
#   - Compose đọc file này cho cả ${VAR} interpolation (qua --env-file) và
#     env_file của container migrate/app.
#
# Chạy:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d
# ============================================================================

# ── Image / Compose (chỉ dùng cho interpolation của compose) ────────────────
APP_IMAGE=pet-helper-app:1.0.0
APP_PORT=3000
# IP tĩnh của container db trong Docker network (DBeaver SSH tunnel trỏ vào đây).
# Đổi DB_STATIC_IP/DOCKER_SUBNET nếu bị trùng với network sẵn có trên máy đích.
DB_STATIC_IP=172.30.0.10
DOCKER_SUBNET=172.30.0.0/24

# ── App runtime ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Database (tên service nội bộ Docker — KHÔNG dùng host/127.0.0.1) ────────
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=pet_helper

# ── Secrets (tạo giá trị MỚI, không tái dùng giá trị trong repo) ────────────
JWT_SECRET=CHANGE_ME_RANDOM_64_HEX
SESSION_SECRET=CHANGE_ME_RANDOM_64_HEX

# ── Passkey / WebAuthn ──────────────────────────────────────────────────────
# TODO trước khi public:
#   - PASSKEY_RP_ID = domain thật, KHÔNG kèm scheme (vd: pethelper.vn)
#   - PASSKEY_ORIGIN = origin thật, CÓ scheme + port nếu không phải 443
#     (vd: https://pethelper.vn)
# Lưu ý: app.js đặt cookie.secure=true khi NODE_ENV=production VÀ origin không
# chứa "localhost". Nếu chưa có HTTPS, giữ localhost để tránh cookie bị chặn.
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=Pet Helper
PASSKEY_ORIGIN=http://localhost:3000

# ── Cloudinary (BẮT BUỘC cho upload ảnh ở production) ───────────────────────
# Thiếu các biến này thì ảnh không upload được (không có fallback local trong prod).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Resend (email OTP) ──────────────────────────────────────────────────────
RESEND_API_KEY=

# ── OAuth ───────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── Cloudflare Turnstile ────────────────────────────────────────────────────
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
TURNSTILE_ENFORCE_MOBILE=false
TURNSTILE_USE_TEST_KEYS=false
